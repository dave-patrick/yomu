{
  "manifest_version": 3,
  "name": "Save to Yomu",
  "version": "0.2.0",
  "description": "Save articles to your private Yomu library and playlists.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Yomu",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "author": "Atomic 22 Industries"
}